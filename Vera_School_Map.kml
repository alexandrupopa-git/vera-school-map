<Placemark><name>West London Free School — 3.219 km rule</name><styleUrl>#rule</styleUrl><description><![CDATA[Remaining places by random ballot within 2 miles of the front gate (2023-24 policy; unverified since) (circle from school postcode centre (approximate))]]></description><Polygon><outerBoundaryIs><LinearRing><coordinates>-0.236712,51.521824,0 -0.233671,51.521762,0 -0.230643,51.521576,0 -0.227641,51.521268,0 -0.224678,51.520838,0 -0.221766,51.520288,0 -0.218919,51.519621,0 -0.216147,51.518839,0 -0.213464,51.517946,0 -0.210880,51.516945,0 -0.208407,51.515842,0 -0.206055,51.514640,0 -0.203834,51.513345,0 -0.201754,51.511963,0 -0.199824,51.510498,0 -0.198052,51.508958,0 -0.196445,51.507350,0 -0.195011,51.505679,0 -0.193755,51.503953,0 -0.192683,51.502180,0 -0.191800,51.500368,0 -0.191109,51.498523,0 -0.190613,51.496654,0 -0.190315,51.494768,0 -0.190216,51.492875,0 -0.190315,51.490982,0 -0.190613,51.489096,0 -0.191109,51.487227,0 -0.191800,51.485382,0 -0.192683,51.483570,0 -0.193755,51.481797,0 -0.195011,51.480071,0 -0.196445,51.478400,0 -0.198052,51.476792,0 -0.199824,51.475252,0 -0.201754,51.473787,0 -0.203834,51.472405,0 -0.206055,51.471110,0 -0.208407,51.469908,0 -0.210880,51.468805,0 -0.213464,51.467804,0 -0.216147,51.466911,0 -0.218919,51.466129,0 -0.221766,51.465462,0 -0.224678,51.464912,0 -0.227641,51.464482,0 -0.230643,51.464174,0 -0.233671,51.463988,0 -0.236712,51.463926,0 -0.239753,51.463988,0 -0.242781,51.464174,0 -0.245783,51.464482,0 -0.248746,51.464912,0 -0.251658,51.465462,0 -0.254505,51.466129,0 -0.257277,51.466911,0 -0.259960,51.467804,0 -0.262544,51.468805,0 -0.265017,51.469908,0 -0.267369,51.471110,0 -0.269590,51.472405,0 -0.271670,51.473787,0 -0.273600,51.475252,0 -0.275372,51.476792,0 -0.276979,51.478400,0 -0.278413,51.480071,0 -0.279669,51.481797,0 -0.280741,51.483570,0 -0.281624,51.485382,0 -0.282315,51.487227,0 -0.282811,51.489096,0 -0.283109,51.490982,0 -0.283208,51.492875,0 -0.283109,51.494768,0 -0.282811,51.496654,0 -0.282315,51.498523,0 -0.281624,51.500368,0 -0.280741,51.502180,0 -0.279669,51.503953,0 -0.278413,51.505679,0 -0.276979,51.507350,0 -0.275372,51.508958,0 -0.273600,51.510498,0 -0.271670,51.511963,0 -0.269590,51.513345,0 -0.267369,51.514640,0 -0.265017,51.515842,0 -0.262544,51.516945,0 -0.259960,51.517946,0 -0.257277,51.518839,0 -0.254505,51.519621,0 -0.251658,51.520288,0 -0.248746,51.520838,0 -0.245783,51.521268,0 -0.242781,51.521576,0 -0.239753,51.521762,0 -0.236712,51.521824,0 -0.236712,51.521824,0</coordinates></LinearRing></outerBoundaryIs></Polygon></Placemark>
